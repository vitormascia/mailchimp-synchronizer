{
    "name": "mailchimp-synchronizer",
    "version": "1.0.0",
    "description": "Syncs contacts from Trio's MockAPI to Mailchimp",
    "type": "module",
    "main": "build/app/entry-points/app.entry-points.apiBoot.js",
    "license": "ISC",
    "scripts": {
        "start": "node --experimental-specifier-resolution=node ./build/app/entry-points/app.entry-points.apiBoot.js && node ./build/app/entry-points/app.entry-points.consumersBoot.js",
        "start:api": "node --experimental-specifier-resolution=node ./build/app/entry-points/app.entry-points.apiBoot.js",
        "start:consumers": "node --experimental-specifier-resolution=node ./build/app/entry-points/app.entry-points.consumersBoot.js",
        "lint": "eslint ./src --ext .js,.ts",
        "lint:fix": "npm run lint -- --fix && eslint --fix",
        "types:check": "tsc --noEmit",
        "build": "rm -rf build && tsc --pretty",
        "compiler": "tsc --pretty",
        "compiler:watch": "tsc --watch",
        "reinstall-modules": "rm -rf node_modules package-lock.json && npm install"
    },
    "dependencies": {
        "@hapi/boom": "^10.0.0",
        "@types/express": "^4.17.16",
        "axios": "^1.2.6",
        "body-parser": "^1.20.1",
        "cors": "^2.8.5",
        "express": "^4.18.2",
        "express-async-errors": "^3.1.1",
        "helmet": "^6.0.1",
        "http-status-codes": "^2.2.0",
        "lodash": "^4.17.21",
        "typescript": "4.9.4",
        "winston": "^3.8.2"
    },
    "devDependencies": {
        "@types/cors": "^2.8.13",
        "@types/lodash": "^4.14.191",
        "@types/node": "^18.11.18",
        "@typescript-eslint/eslint-plugin": "^5.49.0",
        "@typescript-eslint/parser": "^5.49.0",
        "eslint": "^8.33.0",
        "eslint-plugin-import": "^2.27.5",
        "eslint-plugin-simple-import-sort": "^10.0.0"
    }
}
