{
    "name": "mailchimp-synchronizer",
    "version": "1.0.0",
    "description": "Syncs contacts from Trio's MockAPI to Mailchimp",
    "type": "module",
    "main": "./build/app/entry-points/app.entry-points.apiBoot.ts",
    "license": "ISC",
    "scripts": {
        "api:boot:ts": "npx tsx ./src/app/entry-points/app.entry-points.apiBoot.ts",
        "api:boot:js": "node ./build/app/entry-points/app.entry-points.apiBoot.js",
        "api:boot-watch:ts": "nodemon --watch ./src/**/*.ts --exec ts-node ./src/app/entry-points/app.entry-points.apiBoot.ts",
        "api:build": "npm run reinstall-modules && npm run ts:compile && npm run lint:fix",
        "lint": "eslint ./src --ext .js,.ts",
        "lint:fix": "npm run lint -- --fix && eslint --fix",
        "ts:compile": "rimraf build && tsc --pretty",
        "ts:compile-watch": "rimraf build && tsc --watch --pretty",
        "ts:check": "tsc --noEmit --pretty",
        "reinstall-modules": "rimraf node_modules && npm ci"
    },
    "dependencies": {
        "@hapi/boom": "^10.0.1",
        "@mailchimp/mailchimp_marketing": "^3.0.80",
        "axios": "^1.9.0",
        "body-parser": "^2.2.0",
        "camelcase-keys": "^9.1.3",
        "cors": "^2.8.5",
        "express": "^5.1.0",
        "helmet": "^8.1.0",
        "http-status-codes": "^2.3.0",
        "joi": "^17.13.3",
        "lodash": "^4.17.21",
        "phone": "^3.1.59",
        "snakecase-keys": "^8.0.1",
        "ts-node": "^10.9.2",
        "tslib": "^2.8.1",
        "typescript": "5.8.3",
        "uuid": "^11.1.0",
        "winston": "^3.17.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.1",
        "@types/lodash": "^4.17.16",
        "@types/node": "^22.15.3",
        "@types/uuid": "^10.0.0",
        "@typescript-eslint/eslint-plugin": "^8.31.1",
        "@typescript-eslint/parser": "^8.31.1",
        "eslint": "^9.26.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "nodemon": "^3.1.10",
        "rimraf": "^6.0.1"
    }
}
