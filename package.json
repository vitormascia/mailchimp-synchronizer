{
    "name": "mailchimp-synchronizer",
    "version": "1.0.0",
    "description": "Syncs contacts from Trio's MockAPI to Mailchimp",
    "type": "module",
    "main": "./build/app/entry-points/app.entry-points.apiBoot.ts",
    "license": "ISC",
    "scripts": {
        "api:boot:ts": "ts-node ./src/app/entry-points/app.entry-points.apiBoot.ts",
        "api:boot:js": "node ./build/app/entry-points/app.entry-points.apiBoot.js",
        "api:boot-watch:ts": "nodemon --watch ./src/**/*.ts --exec ts-node ./src/app/entry-points/app.entry-points.apiBoot.ts",
        "lint": "eslint ./src --ext .js,.ts",
        "lint:fix": "npm run lint -- --fix && eslint --fix",
        "ts:compile": "tsc --pretty",
        "ts:compile-watch": "tsc --watch --pretty",
        "ts:check": "tsc --noEmit --pretty",
        "reinstall-modules": "rimraf node_modules && npm ci"
    },
    "dependencies": {
        "@hapi/boom": "^10.0.0",
        "@mailchimp/mailchimp_marketing": "^3.0.80",
        "axios": "^1.2.6",
        "body-parser": "^1.20.1",
        "camelcase-keys": "^8.0.2",
        "cors": "^2.8.5",
        "express": "^4.18.2",
        "express-async-errors": "^3.1.1",
        "helmet": "^6.0.1",
        "http-status-codes": "^2.2.0",
        "joi": "^17.7.0",
        "lodash": "^4.17.21",
        "phone": "^3.1.33",
        "snakecase-keys": "^5.4.5",
        "ts-node": "^10.9.1",
        "tslib": "^2.5.0",
        "typescript": "4.9.4",
        "uuid": "^9.0.0",
        "winston": "^3.8.2"
    },
    "devDependencies": {
        "@types/cors": "^2.8.13",
        "@types/express": "^4.17.16",
        "@types/lodash": "^4.14.191",
        "@types/node": "^18.11.18",
        "@types/uuid": "^9.0.0",
        "@typescript-eslint/eslint-plugin": "^5.49.0",
        "@typescript-eslint/parser": "^5.49.0",
        "eslint": "^8.33.0",
        "eslint-plugin-import": "^2.27.5",
        "eslint-plugin-simple-import-sort": "^10.0.0",
        "nodemon": "^2.0.20",
        "rimraf": "^4.1.2"
    }
}
